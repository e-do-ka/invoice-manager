<%= form_with model: invoice, class: "form" do |f| %>
  <% if invoice.errors.any? %>
    <div class="form-errors">
      <ul>
        <% invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-controller="invoice-items">
    <div class="card">
      <h2>基本情報</h2>
      <div class="form-grid">
        <div class="form-field">
          <%= f.label :client_id %>
          <%= f.collection_select :client_id, Client.order(:name), :id, :name,
                { prompt: "顧客を選択" }, class: "input" %>
        </div>
        <div class="form-field">
          <%= f.label :issue_date %>
          <%= f.date_field :issue_date, class: "input" %>
        </div>
        <div class="form-field">
          <%= f.label :due_date %>
          <%= f.date_field :due_date, class: "input" %>
        </div>
        <div class="form-field">
          <%= f.label :tax_rate %>
          <%= f.number_field :tax_rate, min: 0, max: 100, class: "input",
                data: { invoice_items_target: "taxRate", action: "input->invoice-items#recalculate" } %>
        </div>
      </div>
      <div class="form-field">
        <%= f.label :notes %>
        <%= f.text_area :notes, rows: 2, class: "input", placeholder: "請求書に印字される備考（任意）" %>
      </div>
    </div>

    <div class="card">
      <h2>明細</h2>
      <table class="table items-table">
        <thead>
          <tr>
            <th>品目・内容</th>
            <th class="num col-qty">数量</th>
            <th class="num col-price">単価（税抜）</th>
            <th class="num col-amount">金額</th>
            <th class="col-remove"></th>
          </tr>
        </thead>
        <tbody data-invoice-items-target="rows">
          <%# hidden の id はテーブル構造を壊さないよう行内で明示的に出力する %>
          <%= f.fields_for :invoice_items, include_id: false do |item_form| %>
            <%= render "item_fields", f: item_form %>
          <% end %>
        </tbody>
      </table>

      <template data-invoice-items-target="template">
        <%= f.fields_for :invoice_items, InvoiceItem.new, child_index: "NEW_RECORD", include_id: false do |item_form| %>
          <%= render "item_fields", f: item_form %>
        <% end %>
      </template>

      <button type="button" class="btn btn-ghost" data-action="invoice-items#add">＋ 明細行を追加</button>

      <div class="form-totals">
        <div><span>小計</span><span data-invoice-items-target="subtotal">¥0</span></div>
        <div><span>消費税</span><span data-invoice-items-target="tax">¥0</span></div>
        <div class="grand"><span>合計</span><span data-invoice-items-target="total">¥0</span></div>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit invoice.persisted? ? "更新する" : "作成する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", invoice.persisted? ? invoice_path(invoice) : invoices_path, class: "btn btn-ghost" %>
  </div>
<% end %>
